.DS_Store

# Generated by XcodeGen from ios/project.yml
ios/Fledge.xcodeproj/

# Build output
ios/build/
DerivedData/
xcuserdata/

# Personal signing settings (Apple team ID)
ios/Local.xcconfig

# Signing material, should any ever land here
*.mobileprovision
*.p12
*.cer
*.certSigningRequest
.env

# Personal context for Claude (never public)
CLAUDE.local.md
.claude/settings.local.json

# Sniffing session recordings and coach logs
firmware/captures/
firmware/Relay/LocalRadioId.h
firmware/Relay/LocalPairTestPacket.h

# Python bytecode
__pycache__/

# Editor settings made on this Mac for the Arduino sketches (they hold
# local paths): rebuild with arduino-cli --only-compilation-database
.vscode/c_cpp_properties.json
firmware/.build/
